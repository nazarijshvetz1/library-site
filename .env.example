# Assistant additions only. Existing library runtime settings stay in Sites.
# Put the real key in ignored .env.local; never commit it here.
OPENAI_API_KEY=
ASSISTANT_ENABLED=false
ASSISTANT_WRITES_ENABLED=false
ASSISTANT_LIBRARIAN_REALTIME_MODEL=gpt-realtime-2.1
ASSISTANT_LIBRARIAN_TEXT_MODEL=gpt-6-astra
ASSISTANT_TEACHER_REALTIME_MODEL=gpt-realtime-mini
ASSISTANT_TEACHER_TEXT_MODEL=gpt-5.4-mini
ASSISTANT_LIBRARIAN_DAILY_SESSIONS=unlimited
ASSISTANT_TEACHER_DAILY_SESSIONS=12
